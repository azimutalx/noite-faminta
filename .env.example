# ==============================================================================
# NOITE FAMINTA: SANGUE & PRATA - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# NUNCA insira senhas reais neste arquivo. Copie para .env localmente.
# ==============================================================================

# Ambiente e Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Segurança e Criptografia (JWT)
JWT_SECRET=substitua_por_uma_chave_secreta_minimo_64_caracteres_aleatorios
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=substitua_por_uma_chave_secreta_refresh_minimo_64_caracteres
REFRESH_TOKEN_EXPIRATION=7d

# Banco de Dados PostgreSQL (Local ou RDS via Terraform)
DATABASE_URL=postgresql://noite_admin:senha_local_dev@localhost:5432/noite_faminta_db?schema=public

# Cache e Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379

# Observabilidade
LOG_LEVEL=info
